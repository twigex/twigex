# Shared secret that signs/verifies the JWT Twigex sends to Cube.js.
# MUST match Twigex TWIGEX_COLLIMATO_CUBE_API_SECRET.
CUBEJS_API_SECRET=change-me-shared-jwt-secret

# Base URL of Twigex's internal Cube callback API (private network only).
# Cube.js appends /schema, /schema-version and /connection to this.
TWIGEX_INTERNAL_URL=http://twigex:3000/api/internal/cube

# Shared secret Cube.js sends back to Twigex on every internal callback.
# MUST match Twigex TWIGEX_COLLIMATO_CUBE_CALLBACK_SECRET.
CUBE_CALLBACK_SECRET=change-me-callback-secret
