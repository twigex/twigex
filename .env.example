# TWIGEX Environment Variables
# Copy this file to .env and fill in your values

#DATABASE (required) 
TWIGEX_DB_HOST=127.0.0.1
TWIGEX_DB_PORT=3306
TWIGEX_DB_USER=admin
TWIGEX_DB_PASSWORD=password
TWIGEX_DB_NAME=twigex
TWIGEX_DB_DRIVER=mysql
TWIGEX_DB_READ_TIMEOUT=30s
TWIGEX_DB_WRITE_TIMEOUT=30s
TWIGEX_DB_MAX_OPEN_CONNS=25
TWIGEX_DB_MAX_IDLE_CONNS=10
TWIGEX_DB_CONN_MAX_LIFETIME_MINUTES=60
TWIGEX_DB_CONN_MAX_IDLE_TIME_MINUTES=30
TWIGEX_DB_QUERY_TIMEOUT=30

#SERVER
TWIGEX_SERVER_SITE_URL=http://localhost:3000
TWIGEX_SERVER_PORT=3000
TWIGEX_SERVER_DEFAULT_LOCALE=en
TWIGEX_SERVER_SESSION_LENGTH_DAYS=30

# Required: exactly 32 characters
# Generate with: openssl rand -hex 16
TWIGEX_SERVER_ENCRYPT_KEY=a1b2c3d4e5f6a1b2c3d4e5f6a1b2c3d4

#TLS
TWIGEX_SERVER_TLS_CERT_FILE=
TWIGEX_SERVER_TLS_KEY_FILE=

#REDIS
TWIGEX_REDIS_ADDRESS=localhost:6379
TWIGEX_REDIS_PASSWORD=redispassword

#SMTP
TWIGEX_SMTP_HOST=localhost
TWIGEX_SMTP_PORT=1025
TWIGEX_SMTP_USERNAME=
TWIGEX_SMTP_PASSWORD=
TWIGEX_SMTP_SECURITY=
TWIGEX_SMTP_AUTH_ENABLED=false
TWIGEX_SMTP_FROM_ADDRESS=
TWIGEX_SMTP_FROM_NAME=Twigex
TWIGEX_SMTP_REPLY_TO=

#OFFICE
TWIGEX_OFFICE_ENABLE=false
TWIGEX_OFFICE_TYPE=
TWIGEX_OFFICE_HOST=http://localhost:9980
TWIGEX_OFFICE_SECRET=

#CHANNEL
TWIGEX_CHANNEL_ENABLED=false
TWIGEX_CHANNEL_HOST=ws://localhost:7880
TWIGEX_CHANNEL_KEY=
TWIGEX_CHANNEL_SECRET=
TWIGEX_CHANNEL_LINK_PREVIEWS=true

#CHANNEL GIF
TWIGEX_CHANNEL_GIF_ENABLED=false
TWIGEX_CHANNEL_GIF_API_KEY=
TWIGEX_CHANNEL_GIF_CLIENT_KEY=

#LDAP
TWIGEX_LDAP_ENABLED=false
TWIGEX_LDAP_HOST=ldap.example.com
TWIGEX_LDAP_PORT=389
TWIGEX_LDAP_BASE_DN=dc=example,dc=com
TWIGEX_LDAP_BIND_DN=cn=admin,dc=example,dc=com
TWIGEX_LDAP_BIND_PASSWORD=
TWIGEX_LDAP_CONNECTION_SECURITY=none
TWIGEX_LDAP_CA_CERT=
TWIGEX_LDAP_TIMEOUT_SECONDS=10
TWIGEX_LDAP_INSECURE_SKIP_VERIFY=false
TWIGEX_LDAP_USER_FILTER=(uid={0})
TWIGEX_LDAP_USERNAME_ATTR=uid
TWIGEX_LDAP_ID_ATTR=entryUUID
TWIGEX_LDAP_FIRST_NAME_ATTR=givenName
TWIGEX_LDAP_LAST_NAME_ATTR=sn
TWIGEX_LDAP_EMAIL_ATTR=mail
TWIGEX_LDAP_ALLOWED_GROUPS=

#STORAGE
TWIGEX_STORAGE_TYPE=local
TWIGEX_STORAGE_NAME=Local storage
TWIGEX_STORAGE_PATH=data/files

# S3 only — required if TWIGEX_STORAGE_TYPE=s3
TWIGEX_STORAGE_ENDPOINT=
TWIGEX_STORAGE_ACCESS_KEY=
TWIGEX_STORAGE_SECRET_KEY=
TWIGEX_STORAGE_BUCKET=
TWIGEX_STORAGE_SSL=true

#ADMIN (first boot only)
# Creates initial admin user if no users exist in DB
TWIGEX_ADMIN_NAME=Admin
TWIGEX_ADMIN_LASTNAME=User
TWIGEX_ADMIN_USERNAME=admin
TWIGEX_ADMIN_EMAIL=admin@example.com
TWIGEX_ADMIN_PASSWORD=

#LICENSE
TWIGEX_LICENSE=
